# Copy this to /opt/0brien/.env on the droplet and fill in real values.
# Never commit the real .env - docker-compose.yml reads it via env_file.

# The site's public domain - feeds both Caddy's TLS/routing and the
# frontend's API_URL.
SITE_DOMAIN=frosteato.com

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# php bin/console secrets:generate-keys or any long random string
APP_SECRET=change-me
