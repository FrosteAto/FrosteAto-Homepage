FROM php:8.4-fpm-alpine

# Local dev only: same runtime as Dockerfile (nginx + php-fpm) but the app
# code isn't baked in - docker-compose.yml bind-mounts the real backend/
# directory over /app, including the vendor/ already installed on the
# host, so edits take effect without a rebuild.

RUN apk add --no-cache \
        nginx \
        postgresql-dev \
        icu-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libwebp-dev \
        libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql pgsql intl gd zip exif opcache

RUN { \
        echo 'upload_max_filesize=40M'; \
        echo 'post_max_size=800M'; \
        echo 'max_file_uploads=100'; \
        echo 'memory_limit=1024M'; \
        echo 'max_execution_time=300'; \
    } > /usr/local/etc/php/conf.d/uploads.ini

WORKDIR /app

COPY docker/nginx.conf /etc/nginx/http.d/default.conf
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
