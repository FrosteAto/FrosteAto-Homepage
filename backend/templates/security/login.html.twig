<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin login | 0brien.dev</title>
    <style>
        /* Palette copied from frontend/src/app/globals.css (light mode only) -
           keep these in sync if that palette changes. */
        :root {
            --color-cream: #fefae0;
            --color-champagne-soft: #f5eed8;
            --color-sage-deep: #bfcb9a;
            --color-tan-deep: #4d3014;
            --color-ink: #283618;
            --color-rust: #6e352c;
        }

        @font-face {
            font-family: "Helvetica Neue Local";
            src: url("/fonts/HelveticaNeueBold.ttf") format("truetype");
            font-weight: 700;
            font-display: swap;
        }

        @font-face {
            font-family: "Commit Mono";
            src: url("/fonts/CommitMono.otf") format("opentype");
            font-display: swap;
        }

        body {
            font-family: "Commit Mono", ui-monospace, monospace;
            background: var(--color-cream);
            color: var(--color-ink);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }

        form {
            background: var(--color-champagne-soft);
            padding: 2rem;
            border-radius: 8px;
            width: 280px;
        }

        h1 {
            font-family: "Helvetica Neue Local", ui-sans-serif, sans-serif;
            font-size: 1.25rem;
            margin: 0 0 1rem;
            color: var(--color-ink);
        }

        label {
            display: block;
            font-size: .875rem;
            margin-bottom: .25rem;
        }

        input {
            width: 100%;
            padding: .5rem;
            margin-bottom: 1rem;
            box-sizing: border-box;
            border: 1px solid var(--color-sage-deep);
            border-radius: 4px;
            background: var(--color-cream);
            color: var(--color-ink);
            font-family: inherit;
        }

        button {
            width: 100%;
            padding: .5rem;
            background: var(--color-tan-deep);
            color: var(--color-cream);
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-family: "Helvetica Neue Local", ui-sans-serif, sans-serif;
            font-weight: 700;
        }

        button:hover {
            opacity: 0.9;
        }

        .error {
            color: var(--color-rust);
            font-size: .875rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
<form method="post">
    <h1>0brien.dev admin</h1>

    {% if error %}
        <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <label for="username">Email</label>
    <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="username" required autofocus>

    <label for="password">Password</label>
    <input type="password" name="_password" id="password" autocomplete="current-password" required>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <button type="submit">Sign in</button>
</form>
</body>
</html>
