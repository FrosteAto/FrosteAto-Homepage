<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Backfill camera settings | 0brien.dev admin</title>
    <style>
        :root {
            --color-cream: #fefae0;
            --color-champagne-soft: #f5eed8;
            --color-sage-deep: #bfcb9a;
            --color-tan-deep: #4d3014;
            --color-ink: #283618;
            --color-rust: #6e352c;
        }

        body {
            font-family: ui-monospace, monospace;
            background: var(--color-cream);
            color: var(--color-ink);
            margin: 0;
            padding: 2rem;
        }

        .page {
            max-width: 480px;
            margin: 0 auto;
        }

        a {
            color: var(--color-tan-deep);
        }

        h1 {
            font-size: 1.25rem;
        }

        h2 {
            font-size: 1rem;
            margin-top: 0;
        }

        .panel {
            background: var(--color-champagne-soft);
            padding: 2rem;
            border-radius: 8px;
            margin-top: 1rem;
        }

        .panel + .panel {
            margin-top: 1rem;
        }

        .panel p:first-child {
            margin-top: 0;
        }

        button {
            width: 100%;
            padding: .5rem;
            background: var(--color-tan-deep);
            color: var(--color-cream);
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 700;
        }

        button:disabled {
            opacity: .5;
            cursor: default;
        }

        .progress-wrap {
            display: none;
            margin-top: 1.5rem;
        }

        progress {
            width: 100%;
            height: 1.25rem;
            accent-color: var(--color-tan-deep);
        }

        .progress-label {
            margin-top: .35rem;
            font-size: .875rem;
        }

        .done {
            color: var(--color-ink);
        }

        .failure {
            color: var(--color-rust);
        }
    </style>
</head>
<body data-csrf-token="{{ csrf_token('settings-backfill') }}" data-missing="{{ missing }}" data-total="{{ total }}">
<div class="page">
    <a href="{{ path('admin') }}">&larr; Back to admin</a>
    <h1>Backfill camera settings</h1>

    <div class="panel">
        <h2>Missing settings</h2>
        <p>Aperture, shutter speed, ISO, and focal length are detected from EXIF at upload time, same as camera and taken-at - but photos uploaded before that existed don't have them yet. This reads each one's original file and fills in whatever its EXIF has.</p>
        {% if missing == 0 %}
            <p class="done" id="missing-done-label">All photos already have settings (or don't have any to find). Nothing to do.</p>
        {% else %}
            <p id="missing-label">{{ missing }} photo{{ missing == 1 ? '' : 's' }} missing settings.</p>
        {% endif %}
        <button type="button" id="missing-button" {{ missing == 0 ? 'disabled' : '' }}>Backfill missing settings</button>
    </div>

    <div class="panel">
        <h2>Re-check all photos</h2>
        <p>Re-reads every photo's EXIF and overwrites its settings fields, including ones already set - only needed after a fix to how settings are detected, since otherwise already-processed ones are skipped.</p>
        <button type="button" id="all-button" {{ total == 0 ? 'disabled' : '' }}>Re-check all {{ total }} photo{{ total == 1 ? '' : 's' }}</button>
    </div>

    <div class="panel progress-wrap" id="progress-wrap">
        <progress id="progress-bar" value="0" max="100"></progress>
        <p class="progress-label" id="progress-label"></p>
    </div>
</div>
<script>
    (function () {
        var csrfToken = document.body.dataset.csrfToken;
        var missingButton = document.getElementById('missing-button');
        var allButton = document.getElementById('all-button');
        var missingLabel = document.getElementById('missing-label');
        var progressWrap = document.getElementById('progress-wrap');
        var progressBar = document.getElementById('progress-bar');
        var progressLabel = document.getElementById('progress-label');

        // Safety net against an unbounded loop if every remaining photo
        // somehow keeps failing - well past what ~1000 photos in 20-photo
        // batches should ever need.
        var MAX_ROUNDS = 500;

        function runBatch(mode, total, processedSoFar, afterId, round) {
            if (round > MAX_ROUNDS) {
                progressLabel.textContent = 'Stopped after ' + MAX_ROUNDS + ' rounds - some photos may keep failing to process. Processed ' + processedSoFar + ' of ' + total + '.';
                return;
            }

            var body = '_token=' + encodeURIComponent(csrfToken) + '&mode=' + encodeURIComponent(mode) + '&afterId=' + encodeURIComponent(afterId);

            fetch('{{ path('admin_photos_backfill_settings_run') }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body,
            })
                .then(function (res) {
                    if (!res.ok) throw new Error('Request failed');
                    return res.json();
                })
                .then(function (data) {
                    var processed = processedSoFar + data.batchSize;
                    var percent = total > 0 ? Math.round((processed / total) * 100) : 100;
                    progressBar.value = Math.min(percent, 100);
                    progressLabel.textContent = 'Processed ' + processed + ' / ' + total;

                    if (data.batchSize === 0) {
                        progressLabel.textContent = 'Done - processed ' + processed + ' / ' + total + '.';
                        return;
                    }

                    runBatch(mode, total, processed, data.lastId, round + 1);
                })
                .catch(function () {
                    progressLabel.innerHTML = '<span class="failure">Something went wrong - refresh the page to see current progress and try again.</span>';
                });
        }

        function start(mode, total) {
            missingButton.disabled = true;
            allButton.disabled = true;
            if (missingLabel) missingLabel.style.display = 'none';
            progressWrap.style.display = 'block';
            progressLabel.textContent = 'Starting…';
            runBatch(mode, total, 0, 0, 1);
        }

        missingButton.addEventListener('click', function () {
            start('missing', parseInt(document.body.dataset.missing, 10));
        });

        allButton.addEventListener('click', function () {
            start('all', parseInt(document.body.dataset.total, 10));
        });
    })();
</script>
</body>
</html>
