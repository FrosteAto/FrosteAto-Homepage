<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bulk upload | 0brien.dev admin</title>
    <style>
        :root {
            --color-cream: #fefae0;
            --color-champagne-soft: #f5eed8;
            --color-sage-deep: #bfcb9a;
            --color-tan-deep: #4d3014;
            --color-ink: #283618;
            --color-rust: #6e352c;
        }

        body {
            font-family: ui-monospace, monospace;
            background: var(--color-cream);
            color: var(--color-ink);
            margin: 0;
            padding: 2rem;
        }

        .page {
            max-width: 480px;
            margin: 0 auto;
        }

        a {
            color: var(--color-tan-deep);
        }

        h1 {
            font-size: 1.25rem;
        }

        form {
            background: var(--color-champagne-soft);
            padding: 2rem;
            border-radius: 8px;
            margin-top: 1rem;
        }

        label {
            display: block;
            font-size: .875rem;
            margin-bottom: .25rem;
            margin-top: 1rem;
        }

        label:first-of-type {
            margin-top: 0;
        }

        select, input[type="file"] {
            width: 100%;
            padding: .5rem;
            box-sizing: border-box;
            border: 1px solid var(--color-sage-deep);
            border-radius: 4px;
            background: var(--color-cream);
            color: var(--color-ink);
            font-family: inherit;
        }

        select[multiple] {
            height: 8rem;
        }

        button {
            margin-top: 1.5rem;
            width: 100%;
            padding: .5rem;
            background: var(--color-tan-deep);
            color: var(--color-cream);
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 700;
        }

        .results {
            margin-top: 1.5rem;
            padding: 1rem;
            background: var(--color-champagne-soft);
            border-radius: 8px;
        }

        .failure {
            color: var(--color-rust);
        }

        .progress-wrap {
            display: none;
            margin-top: 1.5rem;
        }

        progress {
            width: 100%;
            height: 1.25rem;
            accent-color: var(--color-tan-deep);
        }

        .progress-label {
            margin-top: .35rem;
            font-size: .875rem;
        }
    </style>
</head>
<body>
<div class="page">
    <a href="{{ path('admin') }}">&larr; Back to admin</a>
    <h1>Bulk upload photos</h1>
    <p>Pick as many files as you like, an album and tags applied to all of them, and submit. Leave Camera unset to auto-detect it per photo from EXIF, or pick one to apply it to the whole batch instead. Titles and taken-at dates stay editable per photo afterward via the normal Photos list.</p>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.photos) }}
        {{ form_row(form.album) }}
        {{ form_row(form.camera) }}
        {{ form_row(form.tags) }}
        {{ form_widget(form.submit) }}
        <div class="progress-wrap" id="upload-progress-wrap">
            <progress id="upload-progress-bar" value="0" max="100"></progress>
            <p class="progress-label" id="upload-progress-label">0%</p>
        </div>
    {{ form_end(form) }}

    {% if results is not null %}
        <div class="results">
            <p><strong>{{ results.succeeded }}</strong> photo(s) uploaded successfully.</p>
            {% if results.failures|length > 0 %}
                <p>{{ results.failures|length }} failed:</p>
                <ul>
                    {% for failure in results.failures %}
                        <li class="failure">{{ failure }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}
</div>
<script>
    (function () {
        var form = document.querySelector('form');
        var fileInput = form.querySelector('input[type="file"]');
        var submitButton = form.querySelector('button[type="submit"]');
        var progressWrap = document.getElementById('upload-progress-wrap');
        var progressBar = document.getElementById('upload-progress-bar');
        var progressLabel = document.getElementById('upload-progress-label');

        form.addEventListener('submit', function (event) {
            if (fileInput.files.length === 0) return;

            event.preventDefault();

            var xhr = new XMLHttpRequest();
            xhr.open(form.method, form.action || window.location.href);

            xhr.upload.addEventListener('progress', function (e) {
                if (!e.lengthComputable) return;
                var percent = Math.round((e.loaded / e.total) * 100);
                progressBar.value = percent;
                progressLabel.textContent = percent < 100 ? percent + '%' : 'Processing…';
            });

            xhr.addEventListener('load', function () {
                document.open();
                document.write(xhr.responseText);
                document.close();
            });

            xhr.addEventListener('error', function () {
                progressLabel.textContent = 'Upload failed - check your connection and try again.';
                submitButton.disabled = false;
            });

            submitButton.disabled = true;
            progressWrap.style.display = 'block';
            progressBar.value = 0;
            progressLabel.textContent = '0%';

            xhr.send(new FormData(form));
        });
    })();
</script>
</body>
</html>
