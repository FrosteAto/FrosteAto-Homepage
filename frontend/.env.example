# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Base URL of the Symfony API backend, used for server-side data fetching
# (Server Components).
API_URL=http://localhost:8000

# Same backend URL, but exposed to the browser (NEXT_PUBLIC_ prefix) for
# photo <img> tags rendered by Client Components (e.g. the lightbox) - the
# browser fetches images directly from this origin, so it can't be
# server-only. Inlined into the JS bundle at build time: changing it requires
# a rebuild, not just a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000
